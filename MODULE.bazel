http_file(
    name = "kotlin_dom_api_compat_js",
    downloaded_file_path = "kotlin-dom-api-compat-2.3.20.klib",
    sha256 = "6e96e49769048387a048ddbb542765da68d8f4533d3e8f7ddaf10515b2f54134",

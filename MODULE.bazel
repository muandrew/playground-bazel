    sha256 = "668e6d2addcb8fdbddf2811f885ef12fd1455ca73c0298a9c4031d4a77a3f47c",
    urls = ["https://dl.google.com/dl/android/maven2/androidx/compose/runtime/runtime-js/1.9.5/runtime-js-1.9.5.klib"],
)

http_file(
    name = "compose_runtime_annotation_js",
    downloaded_file_path = "runtime-annotation-js-1.9.5.klib",
    sha256 = "ad86380ca8ccdc9c0a5f3c213be32a167c2a9cffb74251ea1a194ded7046d4e4",
    urls = ["https://dl.google.com/dl/android/maven2/androidx/compose/runtime/runtime-annotation-js/1.9.5/runtime-annotation-js-1.9.5.klib"],
)


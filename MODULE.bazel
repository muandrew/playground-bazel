)

http_file(
    name = "atomicfu_js",
    downloaded_file_path = "atomicfu-js-0.27.0.klib",
    sha256 = "21f2ee31b98438bb990f749cd03b4ec66d73823758cd56db36b169edde08c805",
    urls = ["https://repo1.maven.org/maven2/org/jetbrains/kotlinx/atomicfu-js/0.27.0/atomicfu-js-0.27.0.klib"],

load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@rules_python//python:py_binary.bzl", "py_binary")

package(default_visibility = ["//visibility:public"])

exports_files([
    "runner.py",
    "providers.bzl",
    "compile.bzl",
    "ktx_simple_http.py.tpl",
])

filegroup(
    name = "runner",
    srcs = ["runner.py"],
)

py_binary(
    name = "zipper",
    srcs = ["ktx_zip.py"],
    main = "ktx_zip.py",
)

bzl_library(
    name = "preview_bzl",
    srcs = ["preview.bzl"],
    deps = [":providers_bzl", ":static_files_bzl"],
)

bzl_library(
    name = "static_files_bzl",
    srcs = ["static_files.bzl"],
)

bzl_library(
    name = "providers_bzl",
    srcs = ["providers.bzl"],
)

bzl_library(
    name = "compile_bzl",
    srcs = ["compile.bzl"],
    deps = [":providers_bzl"],
)

load("@rules_android//rules:rules.bzl", "android_binary")
load("@rules_kotlin//kotlin:android.bzl", "kt_android_library")

package(default_visibility = ["//visibility:public"])

# Android App A library target (depends on Library B JVM target)
kt_android_library(
    name = "android_app_lib",
    srcs = glob(["src/main/kotlin/**/*.kt"]),
    custom_package = "com.example.cmp.android",
    kotlinc_opts = "//prototype/cmp/shared:kt_kotlinc_options",
    manifest = "AndroidManifest.xml",
    deps = [
        "//example/cmp/libb:libb-jvm",
        "@android_maven//:androidx_annotation_annotation",
    ],
)

# Android App A APK binary target
android_binary(
    name = "android_app",
    custom_package = "com.example.cmp.android",
    manifest = "AndroidManifest.xml",
    manifest_values = {
        "minSdkVersion": "24",
        "targetSdkVersion": "34",
    },
    deps = [
        ":android_app_lib",
    ],
)

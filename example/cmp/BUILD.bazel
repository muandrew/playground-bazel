package(default_visibility = ["//visibility:public"])

# Convenience alias for the primary web app
alias(
    name = "web",
    actual = "//web:web_app",
)

# Convenience alias for the desktop app
alias(
    name = "desktop",
    actual = "//desktop:desktop_app",
)

# Convenience alias for the Android app
alias(
    name = "android",
    actual = "//android:android_app",
)

# Convenience alias to serve web app locally
alias(
    name = "serve",
    actual = "//web:serve",
)

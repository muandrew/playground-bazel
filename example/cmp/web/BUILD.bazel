load("@kmp_rules//kotlin:defs.bzl", "kt_js_test", "ktx_js_preview_binary", "ktx_simple_http", "ktx_zip")

package(default_visibility = ["//visibility:public"])

# Web App A binary (Compose Multiplatform Canvas/Skiko target)
ktx_js_preview_binary(
    name = "preview",
    srcs = glob(["src/main/kotlin/**/*.kt"]),
    main_fun = "com.example.cmp.web.WebCounterApp",
    deps = [
        "//libb:libb-js",
    ],
    title = "Compose Multiplatform Web - Shared Material 3 Button",
)

# Runs shared state assertions in Node.js. Browser rendering is checked separately.
kt_js_test(
    name = "counter_state_test",
    srcs = glob(["src/test/kotlin/**/*.kt"]),
    compose_enabled = True,
    deps = ["//libb:libb-js"],
)

# Preserve the original test label while making its scope explicit above.
test_suite(
    name = "web_test",
    tests = [":counter_state_test"],
)

# Serve the generated static preview files locally.
ktx_simple_http(
    name = "serve",
    deps = [":preview"],
)

ktx_zip(
    name = "zip",
    deps = [":preview"],
)

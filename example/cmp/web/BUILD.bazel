load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//kotlin:js.bzl", "kt_js_binary", "kt_js_test")

package(default_visibility = ["//visibility:public"])

# Web App A binary (JS / Wasm target depending on Library B JS target)
kt_js_binary(
    name = "web_app",
    srcs = glob(["src/main/kotlin/**/*.kt"]),
    compose_enabled = True,
    data = ["index.html"],
    module_name = "web_app",
    deps = [
        "//example/cmp/libb:libb-js",
    ],
)

# Automated test verifying Web App A shared counter button logic under Node.js
kt_js_test(
    name = "web_test",
    srcs = glob(["src/main/kotlin/**/*.kt"]),
    compose_enabled = True,
    module_name = "web_test",
    deps = [
        "//example/cmp/libb:libb-js",
    ],
)

# Convenience target to serve web app locally in browser
sh_binary(
    name = "serve",
    srcs = ["serve.sh"],
    data = [
        ":web_app",
        "index.html",
    ],
)

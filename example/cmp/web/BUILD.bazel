load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//kotlin:js.bzl", "kt_js_binary")

package(default_visibility = ["//visibility:public"])

# Web App A binary (Compose Multiplatform Canvas/Skiko target)
kt_js_binary(
    name = "web_app",
    srcs = glob(["src/main/kotlin/**/*.kt"]),
    compose_enabled = True,
    data = [
        "index.html",
        "@compose_ui_js//:skiko_mjs",
        "@compose_ui_js//:skiko_wasm",
    ],
    module_name = "web_app",
    deps = [
        "//example/cmp/libb:libb-js",
    ],
)

# Automated test verifying Web App A logic under Node.js
sh_test(
    name = "web_test",
    srcs = ["test.sh"],
    data = [":web_app"],
)

# Convenience target to serve web app locally in browser
sh_binary(
    name = "serve",
    srcs = ["serve.sh"],
    data = [
        ":web_app",
        "index.html",
        "@compose_ui_js//:skiko_mjs",
        "@compose_ui_js//:skiko_wasm",
    ],
)

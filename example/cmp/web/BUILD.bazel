load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//kotlin:js.bzl", "kt_js_binary", "kt_js_test")

package(default_visibility = ["//visibility:public"])

# Web App A binary (Compose Multiplatform Canvas/Skiko target)
kt_js_binary(
    name = "web_app",
    srcs = glob(["src/main/kotlin/**/*.kt"]),
    compose_enabled = True,
    module_name = "web_app",
    deps = [
        "//example/cmp/libb:libb-js",
    ],
)

# Runs shared state assertions in Node.js. Browser rendering is checked separately.
kt_js_test(
    name = "counter_state_test",
    srcs = glob(["src/test/kotlin/**/*.kt"]),
    compose_enabled = True,
    deps = ["//example/cmp/libb:libb-js"],
)

# Preserve the original test label while making its scope explicit above.
test_suite(
    name = "web_test",
    tests = [":counter_state_test"],
)

# Convenience target to serve web app locally in browser
sh_binary(
    name = "serve",
    srcs = ["serve.sh"],
    data = [
        ":web_app",
        "index.html",
    ],
)

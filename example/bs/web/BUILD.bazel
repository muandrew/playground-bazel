load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//kotlin:js.bzl", "kt_js_binary")

package(default_visibility = ["//visibility:public"])

kt_js_binary(
    name = "web_app",
    srcs = glob(["src/main/kotlin/**/*.kt"]),
    compose_enabled = True,
    module_name = "bs_app",
    compose_runtime_klibs = ["@compose_bs_js//:klibs"],
    compose_runtime_assets = [
        "@compose_bs_js//:skiko_wasm",
        "@compose_bs_js//:skiko_mjs",
        "@compose_bs_js//:skiko_reexport",
        "@compose_bs_js//:node_modules",
    ],
    deps = ["//example/bs/shared:shared-js"],
)

sh_binary(
    name = "serve",
    srcs = ["serve.sh"],
    data = [
        ":web_app",
        "index.html",
    ],
)

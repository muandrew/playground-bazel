load("@kmp_rules//kotlin:defs.bzl", "kt_js_binary", "ktx_simple_http", "ktx_zip")

package(default_visibility = ["//visibility:public"])

kt_js_binary(
    name = "web_app",
    srcs = glob(["src/main/kotlin/**/*.kt"]),
    module_name = "bs_app",
    compose_enabled = True,
    deps = ["//shared:shared-js"],
)

# Serve the hand-authored page alongside the generated app files locally.
ktx_simple_http(
    name = "serve",
    srcs = [":web_app", "index.html"],
)

ktx_zip(
    name = "zip",
    srcs = [":web_app", "index.html"],
)

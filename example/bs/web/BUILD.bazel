load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@kmp_rules//kotlin:js.bzl", "kt_js_binary")

package(default_visibility = ["//visibility:public"])

kt_js_binary(
    name = "web_app",
    srcs = glob(["src/main/kotlin/**/*.kt"]),
    compose_enabled = True,
    module_name = "bs_app",
    deps = ["//shared:shared-js"],
)

sh_binary(
    name = "serve",
    srcs = ["serve.sh"],
    data = [
        ":web_app",
        "index.html",
    ],
)

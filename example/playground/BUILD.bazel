load("//kotlin:defs.bzl", "kt_js_library", "ktx_js_preview_binary", "ktx_simple_http", "ktx_zip")

package(default_visibility = ["//visibility:public"])

kt_js_library(
    name = "app",
    srcs = ["App.kt"],
    compose_enabled = True,
)

ktx_js_preview_binary(
    name = "preview",
    deps = [":app"],
    main_fun = "com.example.playground.App",
    title = "Compose Playground",
)

ktx_simple_http(
    name = "serve",
    deps = [":preview"],
)

ktx_zip(
    name = "zip",
    deps = [":preview"],
)

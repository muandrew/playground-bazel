load("//kotlin:defs.bzl", "kt_js_library", "ktx_js_preview", "ktx_simple_http")

package(default_visibility = ["//visibility:public"])

kt_js_library(
    name = "app",
    srcs = ["App.kt"],
    compose_enabled = True,
)

ktx_js_preview(
    name = "preview",

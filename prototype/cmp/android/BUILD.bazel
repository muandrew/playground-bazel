android_binary(
    name = "android_app",
    custom_package = "com.example.sheet.android",
    manifest = "AndroidManifest.xml",
    manifest_values = {
        "minSdkVersion": "24",
        "targetSdkVersion": "34",
    },
    deps = [
        ":android_app_lib",
    ],
